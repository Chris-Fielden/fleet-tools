{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_bash.py"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_edits.py"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_reads.py"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/check_before_stop.py"
            ],
            "timeout": 600,
            "statusMessage": "Running scripts/check.sh before finishing..."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 \"$(git rev-parse --show-toplevel)/bin/fleet-statusline\""
  },
  "permissions": {
    "allow": [
      "Bash(git add -A)",
      "Bash(git commit -m *)",
      "Bash(scripts/check.sh)",
      "Bash(scripts/review.sh)",
      "Bash(ticket note *)",
      "Bash(ticket show *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git push)"
    ]
  }
}
