        }
      ]
    },
    {
      "id": 6,
      "title": "Daily launch cap",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
