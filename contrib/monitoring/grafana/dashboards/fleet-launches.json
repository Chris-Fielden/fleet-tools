{
  "uid": "fleet-launches",
  "title": "Fleet launches",
  "tags": [
    "fleet"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Launches today vs cap",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "expr": "fleet_launches_today",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "expr": "fleet_launches_max_per_day",
          "legendFormat": "cap"
        }
      ]
    },
    {
      "id": 2,
      "title": "Launches left today",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "expr": "fleet_launches_max_per_day - fleet_launches_today",
          "legendFormat": "",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Agents running",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 9,
        "w": 16,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "expr": "fleet_agents_running",
          "legendFormat": "claimed"
        }
      ]
    }
  ]
}
